[Unit]
Description=Sound Server (sounderserver.party)
After=network.target

[Service]
User=sound
WorkingDirectory=/home/sound/sound-server
EnvironmentFile=/etc/soundserver.env
ExecStart=/home/sound/sound-server/.venv/bin/python server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
