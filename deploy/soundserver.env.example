# Copy to /etc/soundserver.env on the VPS and `chmod 600` it.
# Read by the systemd service (EnvironmentFile).

PORT=5000
SOUND_DIR=/home/sound/sounds
DATA_DIR=/home/sound/sound-server/data
CATALOG_SEED=/home/sound/sounds.db

# --- access control (public deploy) ---
REQUIRE_LOGIN=1
USER_PASS=CHANGE_ME_play_password
ADMIN_PASS=CHANGE_ME_admin_password
