# Copy to /etc/soundserver.env on the VPS and `chmod 600` it.
# Read by the systemd service (EnvironmentFile).

PORT=5000
SOUND_DIR=/home/sound/sounds
DATA_DIR=/home/sound/sound-server/data
CATALOG_SEED=/home/sound/sounds.db

# --- edit access (listening is always open — there is NO listen password) ---
# USER_PASS  grants add/edit (the editor tier). Leave blank to disable that tier.
# ADMIN_PASS grants add/edit + remove and the admin controls (lanes/sync/box vol).
USER_PASS=CHANGE_ME_editor_password
ADMIN_PASS=CHANGE_ME_admin_password
