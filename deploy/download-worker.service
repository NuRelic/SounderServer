[Unit]
Description=Sound Server download worker — runs yt-dlp on the Pi (residential IP) for queued URL jobs
After=network-online.target
Wants=network-online.target

[Service]
User=pi
Environment=SS_SERVER=https://sounderserver.party
# Must match the VPS's data/worker_token (cat it on the VPS, paste here):
Environment=SS_WORKER_TOKEN=CHANGE_ME_worker_token
# Optional: path to a Deno binary for full YouTube extraction (a JS runtime)
# Environment=SS_DENO=/usr/local/bin/deno64
ExecStart=/usr/bin/python3 -u /home/pi/download_worker.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
