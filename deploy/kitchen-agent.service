[Unit]
Description=Kitchen Agent — plays sounderserver.party on the kitchen speakers
After=network-online.target
Wants=network-online.target

[Service]
User=pi
Environment=SS_AUDIODEV=hw:3,0
Environment=SS_PASSWORD=CHANGE_ME_play_password
ExecStart=/usr/bin/python3 -u /home/pi/kitchen_agent.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
